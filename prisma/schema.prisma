generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum DocumentCategory {
  SK
  PEDOMAN
  LAPORAN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  role      Role     @default(USER)
  unit      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  formCuciTangan                     FormCuciTangan[]
  formISK                            FormISK[]
  formSubmissions                    FormSubmission[]
  FormAuditKebersihanTangan          FormAuditKebersihanTangan[]
  FormAuditFasilitasKebersihanTangan FormAuditFasilitasKebersihanTangan[]
  FormAuditKepatuhanApd              FormAuditKepatuhanApd[]
  FormBundleIdo                      FormBundleIdo[]
  FormBundleVap                      FormBundleVap[]
  FormBundlePlabsi                   FormBundlePlabsi[]
  FormBundleCauti                    FormBundleCauti[]
  FormMonitoringIpal                 FormMonitoringIpal[]
  FormAuditPembuanganLimbah          FormAuditPembuanganLimbah[]
  FormAuditLinenKotor                FormAuditLinenKotor[]
  FormAuditBendaTajam                FormAuditBendaTajam[]
  FormAuditLimbahCair                FormAuditLimbahCair[]
  FormMonitoringKamarJenazah         FormMonitoringKamarJenazah[]
  FormLaporanTertusukJarum           FormLaporanTertusukJarum[]
  FormMonitoringLinenLaundry         FormMonitoringLinenLaundry[]
  FormPretestEdukasiGizi             FormPretestEdukasiGizi[]
  FormInsidenHais                    FormInsidenHais[]
  FormLogbookIpcn                    FormLogbookIpcn[]

  @@map("users")
}

model SopDocument {
  id             Int      @id @default(autoincrement())
  title          String
  documentNumber String   @map("document_number")
  fileUrl        String   @map("file_url")
  uploadedBy     String   @map("uploaded_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("sop_documents")
}

model OtherDocument {
  id         Int              @id @default(autoincrement())
  title      String
  category   DocumentCategory
  fileUrl    String           @map("file_url")
  uploadedBy String           @map("uploaded_by")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@map("other_documents")
}

model FormCuciTangan {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  date        DateTime
  officerName String   @map("officer_name")
  profession  String
  room        String
  moment1     Boolean  @default(false) @map("moment_1")
  moment2     Boolean  @default(false) @map("moment_2")
  moment3     Boolean  @default(false) @map("moment_3")
  moment4     Boolean  @default(false) @map("moment_4")
  moment5     Boolean  @default(false) @map("moment_5")
  actionDone  Boolean  @default(false) @map("action_done")
  result      String?
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("form_cuci_tangan")
}

model FormISK {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  date           DateTime
  patientName    String   @map("patient_name")
  medicalRecord  String   @map("medical_record")
  catheterAction String?  @map("catheter_action")
  symptoms       String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("form_isk")
}

model FormSubmission {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  formType  String   @map("form_type")
  formTitle String   @map("form_title")
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([formType])
  @@map("form_submissions")
}

